{
  "name": "promptoro",
  "version": "0.2.0",
  "description": "Load YAML files containing LLM tool descriptions for MCP, Anthropic/OpenAI tools, Zod.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "release": "changeset publish",
    "changeset": "changeset",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@types/node": "^22.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.0",
    "vitest": "^2.1.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "llm",
    "tool",
    "tool-use",
    "mcp",
    "anthropic",
    "openai",
    "yaml",
    "prompt",
    "prompt-engineering",
    "zod",
    "schema",
    "agent",
    "typescript",
    "sidecar"
  ],
  "license": "MIT",
  "author": "Naimish Lukhi <lukhinaimish@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naimishlukhi/promptoro.git"
  },
  "homepage": "https://github.com/naimishlukhi/promptoro#readme",
  "bugs": {
    "url": "https://github.com/naimishlukhi/promptoro/issues"
  }
}
